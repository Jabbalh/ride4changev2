# Copier ce fichier en .env.local (non commité) et renseigner les valeurs.
# Supabase : Project Settings → API (ou « Connect ») → Project URL et clé publishable (ou anon).
# Ces valeurs sont publiques (incluses dans le JS du site) : la sécurité repose sur les règles RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
