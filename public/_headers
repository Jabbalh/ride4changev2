# En-têtes HTTP des fichiers statiques (Cloudflare Workers Assets).
# Ne s'applique pas à /api/* ni à /sitemap.xml, servis par le worker (voir worker/index.ts).
#
# Content-Security-Policy : seules ressources externes autorisées, l'API et le Storage Supabase
# (même domaine). 'unsafe-inline' pour les styles : les articles gardent des attributs style
# (couleur, alignement) et l'éditeur Tiptap en pose aussi. Aucun script en ligne n'est exécuté
# (le JSON-LD d'index.html est une donnée, pas un script).
# Si Supabase change de projet, mettre à jour l'adresse ci-dessous (même valeur que VITE_SUPABASE_URL).
# Si un service Cloudflare injecte un script tiers (ex : Web Analytics), il faudra l'ajouter à script-src.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://qcdtwfynsgdffhmvinqf.supabase.co; font-src 'self'; connect-src 'self' https://qcdtwfynsgdffhmvinqf.supabase.co; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Fichiers générés par Vite : leur nom contient un hash, ils ne changent jamais -> cache d'un an
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images et icônes de public/ (noms fixes) : cache d'une semaine, puis revalidation
/*.webp
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
